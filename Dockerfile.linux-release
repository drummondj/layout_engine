# Portable "any Linux x86" release build - see .github/workflows/release.yml
# for how this Dockerfile is invoked.
#
# Deliberately a SEPARATE file from Dockerfile.linux-ci, not a stage added
# to it: that file's own header states its contract (source bind-mounted
# at *run* time, for interactive dev/CI use) - this is a one-shot release
# build that COPYs source in, on a different base OS/package manager (dnf
# vs apt), specifically an OLD glibc baseline (Rocky Linux 8, glibc 2.28)
# so the resulting binary is forward-compatible with newer-glibc systems
# too (glibc's own symbol versioning is one-directional - a binary built
# against an old glibc runs fine on a newer one, not the reverse).
#
# Not tied to any of this repo's other Linux build paths' machine-specific
# constraints (Dockerfile.linux-ci's Ubuntu base, or
# backend/scripts/rocky8-bootstrap.sh's no-root/no-Docker constraint) -
# this container has full root and full outbound network access, so
# packages install normally via dnf and the two source-built tools below
# fetch straight from their real upstream hosts (no need for the
# GitHub-mirror workaround explored, then reverted, for the locked-down
# machine's own bootstrap script).
#
# Bonus: since this uses the same base OS as the user's own locked-down
# Rocky 8 work machine (see BUILD.md), the resulting binary is
# glibc/ABI-matched to it too - plausibly runnable there directly without
# needing the full rootless bootstrap+build, once X11/Tcl-Tk/readline are
# confirmed present.

# ---- base: gcc-toolset-13 (RHEL8's stock GCC 8.5 can't do C++20/23) plus
# every -devel package needed to build/test the backend (le_shell/le_tcl
# included) - dnf install, not rootless RPM extraction, since this
# container has real root. Package names confirmed real via
# backend/scripts/rocky8-bootstrap.sh's own real run logs against a real
# Rocky 8 machine this session (tcl-devel/tk-devel/mesa-* all showed as
# already-installed there; the gcc-toolset-13-* packages downloaded
# successfully). No Skia dependency anywhere in this project anymore (see
# the `source` stage's own comment below) - zlib-devel/libpng-devel/
# libjpeg-turbo-devel/freetype-devel/pcre2-devel used to be here only for
# Skia's own build and are gone; the `tools` stage's own SWIG build passes
# --without-pcre (confirmed via a real failed build here: SWIG's configure
# doesn't recognize --without-pcre2 at all - it silently ignores it and
# still probes for pcre2-config - --without-pcre is the flag its own error
# message names) rather than reintroducing pcre2-devel just for that -
# SWIG's core functionality doesn't need PCRE2-backed regex support.
# backend/scripts/rocky8-bootstrap.sh's own stage_swig has this same
# --without-pcre2 mistake (marked unverified against a real Rocky 8
# machine in backend/CLAUDE.md's Open gaps section) - fixed there too. ----
FROM rockylinux:8 AS base
RUN dnf install -y dnf-plugins-core \
 && (dnf config-manager --set-enabled powertools || dnf config-manager --set-enabled crb || true) \
 && dnf install -y \
    gcc-toolset-13-gcc-c++ gcc-toolset-13-libstdc++-devel gcc-toolset-13-binutils make \
    tcl-devel tk-devel \
    mesa-libGL-devel mesa-libEGL-devel mesa-dri-drivers mesa-libgbm xz-devel \
    # GLFW's own Linux/X11 backend (backend/src/gui/, le_shell's `show_gui`) -
    # CMakeLists.txt's own find_package(glfw3)/FetchContent fallback builds
    # GLFW from source here, which needs these dev headers present to
    # configure its X11 backend at all.
    libX11-devel libXrandr-devel libXinerama-devel libXcursor-devel libXi-devel \
    libXext-devel \
    # le_shell links GNU readline unconditionally now (real line editing/
    # history/Tab completion) - see backend/CLAUDE.md's src/tcl/ bullet.
    readline-devel \
    git curl tar gzip unzip which python3 python3.12 python3.12-pip pkgconfig \
    autoconf automake libtool gettext-devel texinfo m4 \
 && dnf clean all
ENV PATH="/opt/rh/gcc-toolset-13/root/usr/bin:${PATH}"
ENV CC="/opt/rh/gcc-toolset-13/root/usr/bin/gcc"
ENV CXX="/opt/rh/gcc-toolset-13/root/usr/bin/g++"
ENV LD_LIBRARY_PATH="/opt/rh/gcc-toolset-13/root/usr/lib64"

# ---- tools: CMake/Ninja (upstream relocatable releases - RHEL8's own
# cmake/ninja-build packages can't be trusted to satisfy
# backend/CMakeLists.txt's >=3.20 requirement, same reasoning as
# rocky8-bootstrap.sh's stage_cmake/stage_ninja), plus bison+SWIG built
# from source (RHEL8's stock bison is 3.0.4; SWIG 4.2.1's grammar
# declares '%require "3.5"' - a real, already-confirmed build failure this
# project hit on the rootless Rocky 8 path). Installed to /usr/local,
# already on PATH as root - no custom prefix wiring needed, unlike
# rocky8-bootstrap.sh's no-root case. ----
FROM base AS tools
RUN curl -fL -o /tmp/cmake.tar.gz \
      https://github.com/Kitware/CMake/releases/download/v3.28.3/cmake-3.28.3-linux-x86_64.tar.gz \
 && mkdir -p /opt/cmake && tar -xzf /tmp/cmake.tar.gz -C /opt/cmake --strip-components=1 \
 && rm /tmp/cmake.tar.gz
RUN curl -fL -o /tmp/ninja.zip \
      https://github.com/ninja-build/ninja/releases/download/v1.12.1/ninja-linux.zip \
 && mkdir -p /opt/ninja && (cd /opt/ninja && unzip -o /tmp/ninja.zip) \
 && chmod +x /opt/ninja/ninja && rm /tmp/ninja.zip
ENV PATH="/opt/cmake/bin:/opt/ninja:${PATH}"
RUN curl -fL -o /tmp/bison.tar.gz \
      https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.gz \
 && mkdir -p /tmp/bison && tar -xzf /tmp/bison.tar.gz -C /tmp/bison --strip-components=1 \
 && cd /tmp/bison && ./configure --prefix=/usr/local && make -j"$(nproc)" && make install \
 && rm -rf /tmp/bison /tmp/bison.tar.gz
RUN curl -fL -o /tmp/swig.tar.gz \
      https://github.com/swig/swig/archive/refs/tags/v4.2.1.tar.gz \
 && mkdir -p /tmp/swig && tar -xzf /tmp/swig.tar.gz -C /tmp/swig --strip-components=1 \
 && cd /tmp/swig && ./autogen.sh && ./configure --without-pcre --prefix=/usr/local \
 && make -j"$(nproc)" && make install \
 && rm -rf /tmp/swig /tmp/swig.tar.gz

# ---- boost: header-only (Boost.Geometry only, see backend/CMakeLists.txt) -
# same upstream tarball/version as rocky8-bootstrap.sh's stage_boost, not
# RHEL8's own boost-devel package, so both Rocky-8-based build paths stay
# on one consistent Boost version. ----
FROM tools AS boost
RUN curl -fL -o /tmp/boost.tar.gz \
      https://archives.boost.io/release/1.86.0/source/boost_1_86_0.tar.gz \
 && mkdir -p /opt/boost && tar -xzf /tmp/boost.tar.gz -C /opt/boost --strip-components=1 \
 && rm /tmp/boost.tar.gz
ENV BOOST_ROOT=/opt/boost

# ---- tbb: oneTBB built from source - backend/CMakeLists.txt's
# find_package(TBB REQUIRED CONFIG) has no source-build fallback (unlike
# GLFW below), and RHEL8's own dnf package (`tbb-devel`, checked directly:
# 2018.2) predates oneTBB's own CMake-config support entirely (that
# 2018-era API isn't the oneapi::tbb:: surface this project's own
# tbb_core.hpp uses either) - genuinely "NOT-yet-solved" until this stage,
# per CMakeLists.txt's own TBB_DIR comment. v2023.1.0 matches the macOS
# dev machine's own Homebrew tbb version for parity. TBB_TEST=OFF skips
# building its own test suite (not needed, meaningfully faster).
#
# -DTBB_ENABLE_IPO=OFF, not -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF (an
# earlier version of this stage set only the latter) - oneTBB's own
# CMakeLists.txt (cmake/utils.cmake) gates IPO/LTO through its own
# TBB_ENABLE_IPO option (default ON), entirely independent of CMake's
# global CMAKE_INTERPROCEDURAL_OPTIMIZATION variable, so the global-only
# form was a complete no-op for oneTBB's own targets the whole time - real
# GitHub Actions release runs still got IPO-enabled TBB regardless (and
# apparently never hit the failure below there, only in local
# verification - see the QEMU note). Confirmed while verifying the fixes
# below (BUGS_AND_ENHANCEMENTS.md B8-adjacent runtime report: shipped
# le_shell missing libtbb.so.12/generated Tcl procs): a local
# x86_64-under-QEMU-on-arm64 rebuild of this stage with only the old
# global flag hit `lto1: internal compiler error: in return_token, at
# opts-common.cc:2135` linking libtbb.so.12 - the same GCC LTO ICE
# signature this repo has already flagged elsewhere as QEMU-prone, so
# quite possibly still QEMU-only rather than something GitHub's own
# native x86_64 runners would ever have hit either way. Passing the real,
# TBB-specific flag fixes the local repro either way and costs nothing -
# LTO is a performance optimization for oneTBB's own internal code, not
# something this project depends on. ----
FROM boost AS tbb
WORKDIR /tbb
RUN git clone --branch v2023.1.0 --depth 1 https://github.com/uxlfoundation/oneTBB.git . \
 && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DTBB_TEST=OFF -DCMAKE_INSTALL_PREFIX=/opt/tbb -DTBB_ENABLE_IPO=OFF \
 && cmake --build build -j"$(nproc)" \
 && cmake --install build
# CMAKE_PREFIX_PATH (not a guessed TBB_DIR) - find_package's own config-mode
# search checks both <prefix>/lib/cmake/<name>* and
# <prefix>/lib64/cmake/<name>* under every CMAKE_PREFIX_PATH entry, so this
# doesn't need to guess which one GNUInstallDirs picked for this install
# prefix.
ENV CMAKE_PREFIX_PATH=/opt/tbb

# ---- source: the whole repo, copied in fresh (not bind-mounted - this is
# a one-shot CI build, not an interactive dev container). Kept as its own
# stage so every layer before it (the expensive toolchain stages above)
# stays cached across workflow runs regardless of what source changed -
# see .github/workflows/release.yml's GHA cache config.
#
# No Skia dependency anywhere in this project anymore (see
# backend/CMakeLists.txt's own `pipelines` target comment) - a `skia`
# stage used to sit here, built from source against the `tbb` stage below
# (same pinned commit as Dockerfile.linux-ci's own former Skia stage,
# git history has the exact GN args if ever needed again for reference).
# Blend2D (FetchContent, vendored/built from source, statically linked) is
# the only Rasterize/Compose backend now, and le_tcl's own former Skia
# PNG-export path uses Blend2D's built-in PNG codec too - so this stage
# now builds straight on `tbb`, not a `skia` stage, and the base stage's
# own image-codec/font packages (zlib/libpng/libjpeg-turbo/freetype,
# needed only for Skia's own build) are gone from here too (see the base
# stage's own comment). ----
FROM tbb AS source
WORKDIR /workspace
COPY . .

# ---- codegen: src/database/generated/ (and src/api/generated_tcl/,
# src/tcl/generated/) are .gitignore'd build artifacts, produced on
# demand by this repo's own `codegen` fork (repo root, also COPY'd in by
# the source stage) from src/database/schema.py - see the regen-database/
# regen-tcl skills. Dockerfile.linux-ci/rocky8-bootstrap.sh never needed
# this step because they operate on an already-bootstrapped host checkout
# where these were generated once, ages ago, and left on disk; a COPY'd-in
# fresh checkout has no such history, so backend/pipelines.cpp's #include
# "generated/property.hpp" fails outright without this - confirmed by
# hitting exactly that failure before adding this stage. codegen's own
# pyproject.toml requires Python >=3.11 (RHEL8's stock `python3` is 3.6) -
# poetry-core is a standard PEP 517 backend, so a plain `pip install .`
# works without needing the poetry CLI itself. ----
FROM source AS codegen
WORKDIR /workspace/codegen
RUN python3.12 -m pip install --no-cache-dir .
RUN codegen --schema /workspace/backend/src/database/schema.py \
        --output /workspace/backend/src/database/generated \
 && codegen --schema /workspace/backend/src/database/schema.py \
        --output /workspace/backend/src \
        --target tcl

# ---- backend: build + test. ctest gates the whole release - a failing
# test here fails this `docker build`, so nothing downstream ever runs.
# Debug tree for ctest, Release tree for what the shipped le_shell/le_tcl
# actually link - same two-tree split as every other build path in this
# repo, see backend/CLAUDE.md's Build section. ----
FROM codegen AS backend
WORKDIR /workspace/backend
# BACKEND_BUILD_JOBS (not a bare `-j`/nproc): same reasoning as
# Dockerfile.linux-ci's own identically-named ENV - a handful of
# translation units (pipeline_benchmark.cpp pulling in googlebenchmark,
# geometry_test.cpp's Boost.Geometry instantiations) are memory-heavy
# enough per-cc1plus that full nproc-wide parallelism OOM-kills the
# compiler on a memory-constrained builder - confirmed by hitting exactly
# that ("g++: fatal error: Killed signal terminated program cc1plus")
# under full parallelism on this Mac's Docker Desktop VM. Override via
# --build-arg BACKEND_BUILD_JOBS=N on a machine/runner with more memory
# available.
#
# -DLE_ENABLE_TRACY=OFF on the Release-tree configure only (not the
# Debug/ctest tree, which isn't shipped either way) - a shipped release
# binary shouldn't carry Tracy's own profiling instrumentation.
ARG BACKEND_BUILD_JOBS=2
RUN cmake -S . -B build-linux -DCMAKE_BUILD_TYPE=Debug \
 && cmake --build build-linux -j ${BACKEND_BUILD_JOBS} \
 && ctest --test-dir build-linux --output-on-failure \
 && cmake -S . -B build_release-linux -DCMAKE_BUILD_TYPE=Release -DLE_ENABLE_TRACY=OFF \
 && cmake --build build_release-linux --target api pipelines io le_shell le_tcl -j ${BACKEND_BUILD_JOBS}

# ---- bundle: the release asset's actual content, nothing else - just the
# Release-tree le_shell binary, the le_tcl.so module it `load`s at
# startup, the Tcl procs it sources (both the hand-written file and its
# generated companion - le_tcl_procs.tcl's own "flat layout" fallback,
# added for exactly this bundle, looks for
# le_tcl_procs_generated.tcl right alongside itself when no generated/
# subdirectory exists - see that file's own comment), the shared libtbb.so.12
# every one of api/pipelines/le_shell/le_tcl.so links dynamically (`find`,
# not a hardcoded lib/lib64 path - GNUInstallDirs' own choice between the
# two isn't worth pinning down by hand here), the bundled font directory
# Linux's own default_typeface() reads from (backend/CLAUDE.md's Open
# gaps), and lucide.ttf (the toolbar icon font, le_gui.cpp) - not the raw
# build tree/CMake cache. lucide.ttf is copied from build_release-linux/
# itself, not backend/'s own source tree - backend/CMakeLists.txt's own
# file(COPY ...) right after FetchContent_MakeAvailable(lucide_font) puts
# a real copy there specifically so this bundle stage (and
# le_gui.cpp's own exe-relative runtime fallback, once shipped) don't
# need to know FetchContent's own internal cache path. Both fonts were a
# real, confirmed gap - a Linux release build reported every text label
# AND every toolbar icon rendering blank, traced to default_typeface()'s
# fallback still pointing at a since-removed flutter_plugin bundling
# convention (lib/ instead of fonts/) and lucide.ttf never being bundled
# at all. ----
FROM backend AS bundle
RUN mkdir -p /bundle/fonts \
 && cp build_release-linux/le_shell /bundle/ \
 && cp build_release-linux/le_tcl.so /bundle/ \
 && cp build_release-linux/lucide.ttf /bundle/ \
 && cp src/tcl/le_tcl_procs.tcl /bundle/ \
 && cp src/tcl/generated/le_tcl_procs_generated.tcl /bundle/ \
 && cp -r assets/fonts/. /bundle/fonts/ \
 && find /opt/tbb -name 'libtbb.so*' -exec cp -P {} /bundle/ \;

# ---- smoke-test the bundle exactly as a real user runs it: extracted
# into its own directory elsewhere, `le_shell` invoked with no -module/
# -procs flags and no LE_TCL_MODULE/LE_TCL_PROCS_PATH env vars, so its own
# resolve_path() (le_shell.cpp) must fall all the way through its
# compile-time default (this image's own build tree path,
# /workspace/backend/build_release-linux/le_tcl.so, baked in by
# CMakeLists.txt at this same `docker build`'s configure step) to its
# executable-relative fallback, the same way it would on a machine that
# never had /workspace at all - added after a real, repeated report
# (`load` failing with "couldn't load file
# .../build_release-linux/le_tcl.so: No such file or directory") that
# reached a shipped release before anything caught it.
#
# build_release-linux is moved out of the way first (nothing after this
# stage needs it - `export` below copies only /bundle) specifically so
# the compile-time default genuinely can't resolve here either; without
# that, this whole check would silently pass regardless of whether the
# fallback actually works, since that build-tree file still exists
# in-image at this point otherwise.
RUN mv build_release-linux build_release-linux.hidden-for-bundle-smoke-test \
 && mkdir -p /tmp/bundle-smoke-test \
 && cp -r /bundle/. /tmp/bundle-smoke-test/ \
 && cd /tmp/bundle-smoke-test \
 && echo 'puts LE_SHELL_BUNDLE_SMOKE_OK' > smoke.tcl \
 && ./le_shell smoke.tcl > smoke.log 2>&1 \
 && grep -q LE_SHELL_BUNDLE_SMOKE_OK smoke.log \
 && rm -rf /tmp/bundle-smoke-test

# ---- export: `docker buildx build --target export --output
# type=local,dest=./dist` (see .github/workflows/release.yml) exports this
# stage's root filesystem directly, so keeping it to just /bundle's
# contents means ./dist *is* the release payload, no docker create/cp
# step needed. ----
FROM scratch AS export
COPY --from=bundle /bundle /
