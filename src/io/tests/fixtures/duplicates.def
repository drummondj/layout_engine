VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN duplicates_test ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
ROW ROW_0 CORE 0 0 N DO 10 BY 1 STEP 100 0 ;
ROW ROW_0 CORE 0 5000 FS DO 20 BY 1 STEP 100 0 ;
VIAS 2 ;
- DESIGN_VIA
  + RECT M1 ( -50 -50 ) ( 50 50 ) ;
- DESIGN_VIA
  + RECT M2 ( -60 -60 ) ( 60 60 ) ;
END VIAS
REGIONS 2 ;
- R1 ( 0 0 ) ( 100 100 ) ;
- R1 ( 200 200 ) ( 300 300 ) ;
END REGIONS
COMPONENTS 2 ;
- U1 CELL + PLACED ( 0 0 ) N ;
- U1 CELL + PLACED ( 500 500 ) S ;
END COMPONENTS
PINS 4 ;
- P1 + NET P1 + LAYER M1 ( -10 -10 ) ( 10 10 ) + PLACED ( 100 100 ) N ;
- P1 + NET P1 + LAYER M1 ( -20 -20 ) ( 20 20 ) + PLACED ( 200 200 ) N ;
- P2 + NET P2
  + PORT + LAYER M1 ( -10 -10 ) ( 10 10 ) + PLACED ( 300 300 ) N ;
- P2 + NET P2
  + PORT + LAYER M2 ( -10 -10 ) ( 10 10 ) + PLACED ( 400 400 ) N ;
END PINS
SPECIALNETS 2 ;
- VDD + ROUTED M1 100 ( 0 0 ) ( 1000 0 ) ;
- VDD + ROUTED M2 100 ( 0 0 ) ( 0 1000 ) ;
END SPECIALNETS
NETS 2 ;
- SIG + ROUTED M1 ( 0 0 ) ( 100 0 ) ;
- SIG + ROUTED M2 ( 0 0 ) ( 0 100 ) ;
END NETS
END DESIGN
