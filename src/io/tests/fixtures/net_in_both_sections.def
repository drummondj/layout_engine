VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN net_in_both_sections_test ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
SPECIALNETS 1 ;
- VDD
  + ROUTED M1 100 + SHAPE STRIPE ( 0 0 ) ( 1000 0 )
  + SHIELD SIG M2 100 ( 0 3000 ) ( 1000 3000 )
  + RECT M1 ( 0 0 ) ( 100 100 )
  + USE POWER ;
END SPECIALNETS
NETS 1 ;
- VDD
  + ROUTED M1 ( 0 500 ) ( 1000 500 )
    NEW M2 ( 0 0 ) ( 50 50 )
  + USE POWER ;
END NETS
END DESIGN
