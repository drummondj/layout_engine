VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN route_wires_test ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
VIAS 1 ;
- DESIGN_VIA
  + RECT M1 ( -50 -50 ) ( 50 50 )
  + RECT M2 ( -50 -50 ) ( 50 50 ) ;
END VIAS
SPECIALNETS 1 ;
- VDD
  + ROUTED M1 200 + SHAPE STRIPE ( 0 0 ) ( 1000 0 )
    NEW M1 200 + SHAPE STRIPE ( 0 500 ) TECH_VIA DO 2 BY 3 STEP 100 100 ;
END SPECIALNETS
NETS 1 ;
- A
  + ROUTED M1 ( 0 0 ) ( 1000 0 ) ( 1000 2000 ) TECH_VIA
    NEW M2 ( 1000 2000 ) DESIGN_VIA FS
    NEW M1 ( 3000 0 ) UNKNOWN_VIA
    NEW M1 ( 0 0 ) ( 500 500 ) ;
END NETS
END DESIGN
