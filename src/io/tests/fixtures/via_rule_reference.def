VERSION 5.8 ;
DESIGN via_rule_reference_test ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
VIAS 2 ;
- VIA_ARRAY_1
  + VIARULE VIARULE1
  + CUTSIZE 100 100
  + LAYERS M1 V1 M2
  + CUTSPACING 100 100
  + ENCLOSURE 50 10 10 50
  + ROWCOL 2 3
  + ORIGIN 20 -30
  + OFFSET 10 20 -10 -20
  ;
- VIA_PATTERN_1
  + VIARULE VIARULE1
  + CUTSIZE 100 100
  + LAYERS M1 V1 M2
  + CUTSPACING 100 100
  + ENCLOSURE 50 10 10 50
  + ROWCOL 2 3
  + PATTERN 11_00_11
  ;
END VIAS
SPECIALNETS 1 ;
- NET_VIA_WITH_WIDTH
  + ROUTED M1 500 + SHAPE STRIPE ( 0 0 ) ( 1000 0 ) VIA_ARRAY_1
    NEW M1 250 + SHAPE STRIPE ( 2000 0 ) ( 3000 0 ) VIA_PATTERN_1
  ;
END SPECIALNETS
NETS 1 ;
- NET_VIA_NO_WIDTH
  + ROUTED M1 ( 0 1000 ) ( 1000 1000 ) VIA_ARRAY_1
  ;
END NETS
END DESIGN
