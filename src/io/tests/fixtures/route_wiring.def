VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN route_wiring_test ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
VIAS 1 ;
- DESIGN_VIA
  + RECT M1 ( -50 -50 ) ( 50 50 )
  + RECT M2 ( -50 -50 ) ( 50 50 ) ;
END VIAS
SPECIALNETS 1 ;
- VDD
  + ROUTED M1 100 + SHAPE STRIPE ( 0 0 ) ( 1000 0 )
    NEW M2 100 + SHAPE FOLLOWPIN ( 0 0 ) ( 0 1000 )
  + FIXED M1 100 ( 0 2000 ) ( 1000 2000 )
  + SHIELD SIG M2 100 ( 0 3000 ) ( 1000 3000 )
  + FIXED + SHAPE RING + MASK 2 + RECT M1 ( 0 0 ) ( 100 100 )
  + COVER + POLYGON M2 ( 0 0 ) ( 0 100 ) ( 100 0 )
  + VIA TECH_VIA FS ( 500 500 ) ( 600 600 )
  + SHAPE STRIPE + VIA DESIGN_VIA ( 700 700 ) ;
END SPECIALNETS
NETS 1 ;
- SIG
  + FIXED M1 ( 0 0 ) ( 100 0 )
    NEW M1 ( 100 0 ) ( 100 100 )
  + NOSHIELD M2 ( 0 0 ) ( 0 50 ) ;
END NETS
END DESIGN
