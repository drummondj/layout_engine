# Linux build/test environment for this repo - see
# docker-compose.yml for how the stage below is exposed as a runnable
# service, and CLAUDE.md for the equivalent native recipe this mirrors.
#
# Source code is NOT copied into this image - docker-compose.yml bind-
# mounts the repo at /workspace at *run* time, so editing source doesn't
# invalidate any image layer below. Only the OS/toolchain setup happens at
# build time, since that's the expensive, rarely-changing part.

# ---- base: system packages needed by every later stage. No font/
# image-codec libraries (freetype/fontconfig/libpng/...): Blend2D
# (FetchContent, built from source, statically linked) has its own font
# engine and image codecs, loading its one bundled font file from
# LE_FONT_DIR (CMakeLists.txt). ----
FROM ubuntu:24.04 AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang cmake ninja-build git python3 python3-pip pkg-config \
    ca-certificates curl unzip xz-utils bison flex \
    libboost-dev libspdlog-dev libfmt-dev \
    tcl8.6-dev tk8.6-dev swig \
    # GLFW's own Linux/X11 backend (src/gui/, le_shell's `show_gui`) -
    # CLAUDE.md's own "Open gaps" flagged these as a known, not-yet-
    # done requirement; CMakeLists.txt's own find_package(glfw3)/FetchContent
    # fallback builds GLFW from source here, which needs these dev headers
    # present to configure its X11 backend at all.
    libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
    libxext-dev libgl1-mesa-dev \
    # le_shell links GNU readline unconditionally now (real line editing/
    # history/Tab completion) - see CLAUDE.md's src/tcl/ bullet.
    libreadline-dev \
    # oneTBB - CMakeLists.txt's find_package(TBB REQUIRED CONFIG)
    # has no source-build fallback (unlike GLFW above), so this has to be a
    # real package. Ubuntu 24.04's libtbb-dev (2021.11.0) is modern oneTBB
    # with proper CMake config support - confirmed by actually running
    # `docker compose run --rm ci` without this and hitting "Could not
    # find a package configuration file provided by TBB" (CMakeLists.txt's
    # own "Linux/Rocky8 TBB acquisition... NOT-yet-solved" comment was
    # right that this was never actually wired up here).
    libtbb-dev \
 && rm -rf /var/lib/apt/lists/*

# ---- ci: build/test environment for the C++ project (le_shell/le_tcl
# included). Source is bind-mounted at /workspace by docker-compose; this
# stage only provides the toolchain. ----
FROM base AS ci
# Build-job parallelism capped (not bare `-j`/nproc): several translation
# units here (geometry_test.cpp's Boost.Geometry instantiations,
# pipeline_benchmark.cpp pulling in googlebenchmark) are memory-heavy
# enough per-cc1plus that nproc-wide parallelism (10 jobs on this VM's 10
# CPUs) OOM-kills the compiler on the ~8GB-default Docker VM. ENV (not ARG)
# because this is read inside CMD, which runs at container-start time, not
# image-build time - override via `docker compose run -e BUILD_JOBS=N ci`
# on a machine with more RAM available to the Docker VM.
ENV BUILD_JOBS=2
WORKDIR /workspace
# Build trees live at /build/debug and /build/release, outside the bind-
# mounted source (docker-compose.yml backs /build with a named volume so
# local reruns stay incremental). A CMakeCache.txt generated under
# /workspace has absolute paths baked in and can't share a directory with
# the host's own build/build_release, so keeping the container's trees
# off the host entirely means the two never clobber each other.
#
# lef_lib/def_lib (src/lefdef/lef, src/lefdef/def) are the one exception
# to that separation: their vendored Makefiles are BUILD_IN_SOURCE,
# writing liblef.a/libdef.a/*.o/generated headers directly under
# src/lefdef/{lef,def}/ itself - NOT under the build tree, so they're
# shared with whatever a host-native `cmake --build build` last left
# there on the bind-mounted checkout. Those Makefiles' own dependency
# tracking is timestamp-based ("Nothing to be done for 'installlib'"), so
# they happily treat another platform's/toolchain's .o/.a files as
# already up to date instead of rebuilding, and the resulting "undefined
# reference to LefDefParser::..." errors give no hint that the real
# problem is object format, not a missing/misordered library. Force-clean
# both before every container build so this tree is never trusted across
# environments; the same hazard applies in reverse (a host build run
# after this container) - clean-rebuild both on whichever side you touch
# second. Also clear ExternalProject_Add's own stamp directories
# (/build/*/{lef,def}_lib-prefix) - they persist across runs in the
# volume, and their stamp says "already built" regardless of whether the
# artifacts above were just deleted, so without this the build step is
# silently skipped and io/pipelines fail on a missing
# src/lefdef/{lef,def}/include/*.hpp instead.
#
# codegen step (pip install + codegen, both targets): src/database/generated/,
# src/api/generated_tcl/, and src/tcl/generated/ are all .gitignore'd
# build artifacts (see the regen-database/regen-tcl skills), never present
# in a fresh CI checkout. Reinstalling+regenerating on every run (not just
# once) is deliberate, mirroring Dockerfile.linux-release's own codegen
# stage - both codegen/ and src/database/schema.py are bind-mounted source
# that can change between runs, and `pip install .` of a small pure-Python
# package is cheap enough not to matter. --break-system-packages: Ubuntu
# 24.04's system Python is PEP 668-protected; this is an ephemeral,
# single-purpose container, not a shared system, so the usual venv
# reasoning for avoiding it doesn't apply.
CMD ["bash", "-c", "\
    find src/lefdef/lef src/lefdef/def \\( -name '*.o' -o -name '*.a' -o -name 'lef.tab.cpp' -o -name 'lef.tab.h' -o -name 'lef.output' -o -name 'def.tab.cpp' -o -name 'def.tab.h' -o -name 'def.output' \\) -delete && \
    rm -rf src/lefdef/lef/lib src/lefdef/lef/include src/lefdef/lef/bin && \
    rm -rf src/lefdef/def/lib src/lefdef/def/include src/lefdef/def/bin && \
    rm -rf /build/debug/lef_lib-prefix /build/release/lef_lib-prefix && \
    rm -rf /build/debug/def_lib-prefix /build/release/def_lib-prefix && \
    python3 -m pip install --no-cache-dir --break-system-packages ./codegen && \
    codegen --schema src/database/schema.py --output src/database/generated && \
    codegen --schema src/database/schema.py --output src --target tcl && \
    cmake -S . -B /build/debug -DCMAKE_BUILD_TYPE=Debug && \
    cmake --build /build/debug -j ${BUILD_JOBS} && \
    ctest --test-dir /build/debug --output-on-failure && \
    cmake -S . -B /build/release -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /build/release --target api pipelines io le_shell le_tcl -j ${BUILD_JOBS} \
"]
